<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="600dp"
    android:layout_height="600dp"
    android:layout_marginVertical="2dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Texto antes del TextView de nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exploración:"
            android:textSize="16sp"
            android:textColor="#000000"/>

        <!-- Nombre de la exploración -->
        <TextView
            android:id="@+id/tv_leyenda_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Nombre de la exploración"/>

        <!-- Texto antes del TextView de descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nota:"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="8dp"/>

        <!-- Descripción de la exploración -->
        <TextView
            android:id="@+id/tv_leyenda_descripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="Descripción de la exploración"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_editar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_background"
                android:textColor="#FFFFFF"
                android:text="Editar"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btn_eliminar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_background"
                android:textColor="#FFFFFF"
                android:text="Eliminar"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
