<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"> <!-- Centrar horizontalmente los botones -->

        <Button
            android:id="@+id/btnRegisterLocation"
            android:layout_width="200dp"
            android:textColor="@android:color/white"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:layout_marginTop="16dp"
            android:text="Registra tu ubicación" />

        <Button
            android:id="@+id/btnLocateMe"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text=""
            android:textColor="@android:color/white"
            android:drawableLeft="@drawable/baseline_zoom_in_map_24"
            android:background="@drawable/button_background"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</LinearLayout>

